rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function smallString(field, max) { return field is string && field.size() <= max; }
    function profileFieldsValid() {
      return request.resource.data.keys().hasOnly([
        'ownerId','email','name','registration','phone','tradingName','contactPerson',
        'whatsapp','description','category','province','city','coverage','services',
        'cidb','experience','projects','goals','organizationType','updatedAt'
      ])
      && request.resource.data.ownerId == request.auth.uid
      && request.resource.data.get('organizationType', '') in ['', 'business', 'npo']
      && request.resource.data.get('name','') is string
      && request.resource.data.get('name','').size() <= 200
      && request.resource.data.get('email','') is string
      && request.resource.data.get('email','').size() <= 254
      && request.resource.data.get('description','').size() <= 4000
      && request.resource.data.get('services','').size() <= 4000
      && request.resource.data.get('projects','').size() <= 4000;
    }
    match /contractors/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && profileFieldsValid();
      allow update: if isOwner(uid) && (resource.data.ownerId == uid || !('ownerId' in resource.data)) && profileFieldsValid();
      allow delete: if false;
      // Each user owns their conversations and immutable messages.
      match /chats/{chatId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['ownerId','title','sourceTender','createdAt','updatedAt'])
          && request.resource.data.ownerId == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.sourceTender == null || request.resource.data.sourceTender is map);
        allow update: if isOwner(uid)
          && resource.data.ownerId == uid
          && request.resource.data.ownerId == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['role','content','createdAt'])
            && request.resource.data.role in ['assistant','user']
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 12000
            && request.resource.data.createdAt == request.time;
          allow delete: if isOwner(uid);
          allow update: if false;
        }
      }
      match /settings/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'preferences'
          && request.resource.data.keys().hasOnly(['model','updatedAt'])
          && request.resource.data.model is string
          && request.resource.data.model.size() < 130
          && request.resource.data.model.matches('^[a-zA-Z0-9._:-]+/[a-zA-Z0-9._:-]+$');
        allow delete: if false;
      }
      match /savedTenders/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.ownerId == uid
          && request.resource.data.id is string
          && request.resource.data.id.size() < 200
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 280;
        allow update: if false;
      }
      match /documents/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['ownerId','key','name','originalName','description','type','size','category','expiresAt','createdAt'])
          && request.resource.data.ownerId == uid
          && request.resource.data.key is string
          && request.resource.data.key.matches('^contractors/' + uid + '/' + id + '/[a-zA-Z0-9._ ()-]{1,110}$')
          && smallString(request.resource.data.name, 110)
          && smallString(request.resource.data.get('originalName',''), 110)
          && smallString(request.resource.data.get('description',''), 1000)
          && smallString(request.resource.data.type, 180)
          && smallString(request.resource.data.category, 80)
          && smallString(request.resource.data.expiresAt, 20)
          && request.resource.data.size is int
          && request.resource.data.size > 0 && request.resource.data.size <= 15728640
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }
    match /opportunities/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    // Retired public job intake: unauthenticated submissions must not reach Firestore.
    match /jobs/{id} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
